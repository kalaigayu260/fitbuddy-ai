# Copy this file to .env and add your Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Current model names are configurable. Change them if your API account exposes different models.
GEMINI_WORKOUT_MODEL=gemini-3.8-flash
GEMINI_TIP_MODEL=gemini-3.8-flash

# Optional. Leave the default for SQLite.
DATABASE_URL=sqlite:///./fitbuddy.db
